<?xml version="1.0" encoding="utf-8" ?>
<ContentPage Style="{StaticResource PaginaGlobal}" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="jjjitalaExamen.Viesw.vLogin" Title="Login">
    <ScrollView Style="{StaticResource DesplazamientoGlobal}">
        <VerticalStackLayout Style="{StaticResource ContenidoLogin}">
            <Image Style="{StaticResource ImagenGlobal}" Source="login.jpg"
                   HeightRequest="180"
                   HorizontalOptions="Center"
                   Aspect="AspectFit"
                   SemanticProperties.Description="Imagen de inicio de sesión" />
            <Label Style="{StaticResource TituloLogin}" Text="Login" />
            <Grid Style="{StaticResource CuadriculaExamen}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Style="{StaticResource LabelGlobal}" 
                    HorizontalTextAlignment="Center" 
                    VerticalTextAlignment="Center" 
                    Text="Usuario" 
                    Grid.Row="0" 
                    Grid.Column="0" />
                <Entry Style="{StaticResource EntryGlobal}" 
                    HorizontalTextAlignment="Start" 
                    VerticalOptions="Center" 
                    x:Name="txtUsuario" 
                    Grid.Row="0" 
                    Grid.Column="1" />
                <Label Style="{StaticResource LabelGlobal}" 
                    HorizontalTextAlignment="Center" 
                    VerticalTextAlignment="Center" 
                    Text="Contraseña" 
                    Grid.Row="1" 
                    Grid.Column="0" />
                <Entry Style="{StaticResource EntryGlobal}" 
                    HorizontalTextAlignment="Start" 
                    VerticalOptions="Center" 
                    x:Name="txtContrasena" 
                    IsPassword="True" 
                    Grid.Row="1" 
                    Grid.Column="1" />
                <Button Style="{StaticResource BotonGlobal}" x:Name="btnIniciarSesion" 
                    VerticalOptions="Center" 
                    Text="Iniciar sesión" 
                    Clicked="btnIniciarSesion_Clicked" 
                    Grid.Row="2" 
                    Grid.Column="0" 
                    Grid.ColumnSpan="2" />
            </Grid>
            <Button Style="{StaticResource BotonSecundarioGlobal}" x:Name="btnAcercaDe" 
                VerticalOptions="Center" 
                Text="Acerca de" 
                Clicked="btnAcercaDe_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>


